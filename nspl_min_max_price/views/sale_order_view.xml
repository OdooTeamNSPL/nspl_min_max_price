<odoo>
    <record id="view_order_form_inherit_min_max_list" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.min.max.price.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Tree (list) view of order_line inside sale.order -->
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="after">
                <field name="min_price" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="max_price" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>

        </field>
    </record>
</odoo>
