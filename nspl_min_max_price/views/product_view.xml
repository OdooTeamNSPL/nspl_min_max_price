<odoo>
    <record id="product_template_form_view_inherit_min_max" model="ir.ui.view">
        <field name="name">product.template.form.inherit.min.max</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <group string="Price Restriction" groups="nspl_min_max_price.group_set_min_max_price" col="2">
                    <field name="min_price" class="oe_inline"/>
                    <field name="max_price" class="oe_inline"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>